includes:
    - ../pelican/vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    level: 5
    paths:
        - src
    tmpDir: .phpstan-cache
    scanFiles: []
    scanDirectories: []
    ignoreErrors: []
    excludePaths:
        - vendor (?)
